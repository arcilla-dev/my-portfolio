---
import { folders, contacts } from "../../data/about";

const phoneHref = `tel:${contacts.phone.replace(/[^\d+]/g, "")}`;

const summary =
  "flex cursor-pointer list-none items-center gap-2 outline-none select-none transition-colors focus-visible:text-accent [&::-webkit-details-marker]:hidden";
---

<aside
  class="shrink-0 border-b border-line bg-surface text-[0.75rem] md:w-[13rem] md:overflow-y-auto md:border-r md:border-b-0 [scrollbar-width:thin]"
  aria-label="About me files"
>
  <!-- personal-info -->
  <details open class="group/section border-b border-line">
    <summary class:list={[summary, "px-4 py-3 text-fg hover:text-accent"]}>
      <svg viewBox="0 0 24 24" class="size-3 -rotate-90 transition-transform group-open/section:rotate-0" fill="currentColor" aria-hidden="true">
        <path d="M5 8h14l-7 9z" />
      </svg>
      personal-info
    </summary>

    <div class="pb-2">
      {
        folders.map((folder) => (
          <details open={folder.open} class="group/folder">
            <summary class:list={[summary, "px-4 py-1.5 text-muted hover:text-fg"]}>
              <svg viewBox="0 0 24 24" class="size-3 transition-transform group-open/folder:rotate-90" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 6l6 6-6 6" />
              </svg>
              <svg viewBox="0 0 24 24" class="size-4 text-accent" fill="currentColor" aria-hidden="true">
                <path d="M3 6.5A1.5 1.5 0 014.5 5H9l2 2.2h8.5A1.5 1.5 0 0121 8.7v9.8a1.5 1.5 0 01-1.5 1.5h-15A1.5 1.5 0 013 18.5z" />
              </svg>
              {folder.label}
            </summary>

            <ul>
              {folder.files.map((file) => (
                <li>
                  <button
                    type="button"
                    data-file={file.id}
                    data-name={file.name}
                    aria-current="false"
                    class="flex w-full cursor-pointer items-center gap-2 py-1.5 pr-4 pl-[3.1rem] text-left text-muted outline-none transition-colors hover:bg-accent-soft/60 hover:text-fg focus-visible:text-accent aria-[current=true]:bg-accent-soft aria-[current=true]:text-accent"
                  >
                    <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="2" y="5" width="20" height="14" rx="2" />
                      <path d="M6 15V9l3 3 3-3v6M17 9v6m0 0l-2-2m2 2l2-2" />
                    </svg>
                    {file.name}
                  </button>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </details>

  <!-- contacts -->
  <details open class="group/section">
    <summary class:list={[summary, "px-4 py-3 text-fg hover:text-accent"]}>
      <svg viewBox="0 0 24 24" class="size-3 -rotate-90 transition-transform group-open/section:rotate-0" fill="currentColor" aria-hidden="true">
        <path d="M5 8h14l-7 9z" />
      </svg>
      contacts
    </summary>

    <ul class="border-t border-line py-2">
      <li>
        <a
          href={`mailto:${contacts.email}`}
          class="flex items-center gap-2.5 px-4 py-2 text-muted outline-none transition-colors hover:bg-accent-soft/60 hover:text-accent focus-visible:text-accent"
        >
          <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          <span class="break-all">{contacts.email}</span>
        </a>
      </li>
      <li>
        <a
          href={phoneHref}
          class="flex items-center gap-2.5 px-4 py-2 text-muted outline-none transition-colors hover:bg-accent-soft/60 hover:text-accent focus-visible:text-accent"
        >
          <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" />
          </svg>
          <span>{contacts.phone}</span>
        </a>
      </li>
    </ul>
  </details>
</aside>
