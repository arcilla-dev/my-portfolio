---
interface Props {
  facebook?: string;
  facebookUser?: string;
  linkedin?: string;
  githubUser?: string;
  github?: string;
  email?: string;
  owner?: string;
}

const {
  facebookUser = "joshnathaniel.arcilla",
  facebook = `https://facebook.com/${facebookUser}`,
  linkedin = "https://www.linkedin.com/in/josh-nathaniel-arcilla/",
  githubUser = "arcilla-dev",
  github = `https://github.com/${githubUser}`,
  email = "arcilla.jn@gmail.com",
  owner = "Josh Nathaniel Arcilla",
} = Astro.props;

const year = new Date().getFullYear();

const socialLink =
  "flex w-[3.9rem] items-center justify-center border-l border-line text-muted outline-none transition-colors hover:bg-accent-soft hover:text-accent focus-visible:bg-accent-soft focus-visible:text-accent";
---

<footer
  class="fixed inset-x-0 bottom-0 z-20 flex h-(--bar-h) items-stretch justify-between border-t md:grid md:grid-cols-[1fr_auto_1fr] border-line bg-surface/90 text-[0.7rem] backdrop-blur"
>
  <div class="flex items-stretch md:justify-self-start">
    <span class="flex items-center px-4 text-muted max-sm:hidden">find me in:</span>

    <a href={facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook" class:list={[socialLink, "max-sm:border-l-0"]}>
      <svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor" aria-hidden="true">
        <path d="M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.9.4-1.7 1.8-1.7h1.6V3.9c-.3 0-1.3-.2-2.5-.2-2.6 0-4.3 1.6-4.3 4.4v2.4H7.2v3.3h2.9V22h3.4z" />
      </svg>
    </a>

    <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn" class={socialLink}>
      <svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor" aria-hidden="true">
        <path d="M4.5 8.6h3.3V20H4.5V8.6zM6.1 3.5a1.9 1.9 0 110 3.8 1.9 1.9 0 010-3.8zM9.9 8.6h3.1v1.6c.5-.9 1.6-1.9 3.4-1.9 3.4 0 4 2.2 4 5.1V20h-3.3v-5.7c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3V20H9.9V8.6z" />
      </svg>
    </a>

    <a href={`mailto:${email}`} aria-label="Email" title={email} class:list={[socialLink, "border-r border-line"]}>
      <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </svg>
    </a>
  </div>

  <!-- Same grid as the header, so this sits on the same centre axis as the nav -->
  <p class="hidden items-center gap-2 text-muted md:flex md:justify-self-center">
    <span>© {year} {owner}</span>
    <span class="hidden text-line lg:inline" aria-hidden="true">|</span>
    <span class="hidden lg:inline">built with <span class="text-accent">Astro</span> + <span class="text-accent">Tailwind</span></span>
  </p>

  <a
    href={github}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`GitHub profile @${githubUser}`}
    class="group flex items-center gap-2.5 border-l border-line px-4 md:justify-self-end text-muted outline-none transition-colors hover:bg-accent-soft hover:text-accent focus-visible:bg-accent-soft focus-visible:text-accent"
  >
    <span>@{githubUser}</span>
    <svg viewBox="0 0 24 24" class="size-[1.35rem] text-fg transition-colors group-hover:text-accent" fill="currentColor" aria-hidden="true">
      <path d="M12 2a10 10 0 00-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 2.9.8.1-.7.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.7 9.7 0 015.1 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8V21c0 .3.2.6.7.5A10 10 0 0012 2z" />
    </svg>
  </a>
</footer>
