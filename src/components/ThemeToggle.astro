---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const themeBtn =
  "flex cursor-pointer items-center gap-1.5 rounded px-2.5 py-1 text-muted outline-none transition-colors hover:text-fg focus-visible:ring-2 focus-visible:ring-accent aria-pressed:bg-toggle-active aria-pressed:text-fg";
---

<div
  class:list={["items-center gap-0.5 rounded-md bg-surface-alt p-0.5 text-[0.7rem]", className]}
  role="group"
  aria-label="Color theme"
>
  <button type="button" data-theme-option="dark" class={themeBtn}>
    <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" />
    </svg>
    Dark
  </button>
  <button type="button" data-theme-option="light" class={themeBtn}>
    <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    Light
  </button>
</div>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-option]");

  function syncButtons(theme: string) {
    buttons.forEach((btn) => {
      btn.setAttribute("aria-pressed", String(btn.dataset.themeOption === theme));
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const theme = btn.dataset.themeOption!;
      root.dataset.theme = theme;
      try {
        localStorage.setItem("theme", theme);
      } catch {}
      syncButtons(theme);
    });
  });

  // Reflect whatever the head script already applied (saved choice or system preference).
  syncButtons(root.dataset.theme === "light" ? "light" : "dark");
</script>
