---
import { techs, type TechId } from "../../../data/techs";

interface Props {
  id: TechId;
  class?: string;
}

const { id, class: className = "size-4" } = Astro.props;
const tech = techs[id];
---

<svg
  viewBox="0 0 24 24"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={tech.icon}
/>
