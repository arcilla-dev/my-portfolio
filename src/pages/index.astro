---
import BaseLayout from "../layouts/BaseLayout.astro";
import GridBackground from "../components/Hero-components/GridBackground.astro";
import Hero from "../components/Hero-components/Hero.astro"
---

<BaseLayout title="Josh Nathaniel Arcilla | Full-Stack Developer" current="home">
	<main
		id="main"
		class="relative isolate flex min-h-0 flex-1 items-center justify-center px-6 py-[calc(var(--bar-h)+1.5rem)]"
	>
		<GridBackground />
		<Hero/>
	</main>
</BaseLayout>
